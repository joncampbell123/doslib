%defcode
/*

    Data structure for Get_Next_Arena

 */
#pragma pack(push,1)
/* struct Common_Memory_struc */
typedef struct Common_Memory_struc {
    uint16_t        CM_seg;                         /* +0x0000 segment address of start */
    uint16_t        CM_size;                        /* +0x0002 size in paragraphs */
} Common_Memory_struc;
/* end Common_Memory_struc (total 0x0004 bytes) */
#pragma pack(pop)
%enddef

