%defcode
/*

    Data structure for Install_Exception_Handler and Remove_Exception_Handler

 */
#pragma pack(push,1)
/* struct Exception_Handler_Struc */
typedef struct Exception_Handler_Struc {
    uint32_t        EH_Reserved;                    /* +0x0000 Reserved; must be zero */
    uint32_t        EH_Start_EIP;                   /* +0x0004 Starting address of the handler's supported range */
    uint32_t        EH_End_EIP;                     /* +0x0008 Ending address of the handler's supported range */
    uint32_t        EH_Handler;                     /* +0x000C The exception handler */
} Exception_Handler_Struc;
/* end Exception_Handler_Struc (total 0x0010 bytes) */
#pragma pack(pop)
%enddef

