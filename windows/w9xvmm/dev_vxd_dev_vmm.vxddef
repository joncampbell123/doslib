#--------------------------------------
%defconstenum
description     Error code values for GetSetDetailedVMError (GSDVME_*).
description     Error values having the high word set to 2 are intended to be used when a VM fails on start up.
description
description     Source: Windows 3.1 DDK, D:\386\INCLUDE\VMM.INC, line 1007

#       constant                    value
def     GSDVME_PrivInst             0x00010001                    ; Attempt to execute a privileged instruction
def     GSDVME_InvalInst            0x00010002                    ; Attempt to execute an invalid instruction
def     GSDVME_InvalPgFlt           0x00010003                    ; Invalid page fault
def     GSDVME_InvalGpFlt           0x00010004                    ; Invalid general protection fault
def     GSDVME_InvalFlt             0x00010005                    ; Invalid fault
def     GSDVME_UserNuke             0x00010006                    ; User requested running virtual machine be terminated
def     GSDVME_DevNuke              0x00010007                    ; Device-specific problem
def     GSDVME_DevNukeHdwr          0x00010008                    ; Device-specific problem caused by software running in VM
def     GSDVME_NukeNoMsg            0x00010009                    ; Suppress standard messages; the SHELL_Message service is used for custom messages
def     GSDVME_InsMemV86            0x00020001                    ; Insufficient V86 memory
def     GSDVME_InsV86Space          0x00020002                    ; Available V86 address space is less than requested
def     GSDVME_InsMemXMS            0x00020003                    ; Available XMS memory is less than requested
def     GSDVME_InsMemEMS            0x00020004                    ; Available EMS memory is less than requested
def     GSDVME_InsMemV86Hi          0x00020005                    ; Insufficient high MS-DOS memory
def     GSDVME_InsMemVid            0x00020006                    ; Insufficient base video memory
def     GSDVME_InsMemVM             0x00020007                    ; Insufficient base virtual machine memory for control block or instance buffer
def     GSDVME_InsMemDev            0x00020008                    ; Could not allocate base virtual machine memory for device
def     GSDVME_CrtNoMsg             0x00020009                    ; Supress standard messages; the SHELL_Message service is used for custom messages
def     GSDVME_OkNukeMask           0x80000000                    ; Reserved for the exclusive use of the virtual MS-DOS manager
%enddef

