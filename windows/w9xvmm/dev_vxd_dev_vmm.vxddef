%enddef

#--------------------------------------
%defcode
/*

    Data structure for _AddInstanceItem

 */
#pragma pack(push,1)
/* struct InstDataStruc */
typedef struct InstDataStruc {
    uint32_t        InstLinkF;                      /* +0x0000 RESERVED - SET TO 0 */
    uint32_t        InstLinkB;                      /* +0x0004 RESERVED - SET TO 0 */
    uint32_t        InstLinAddr;                    /* +0x0008 Linear address of block start */
    uint32_t        InstSize;                       /* +0x000C Block size, in bytes */
    uint32_t        InstType;                       /* +0x0010 Block type */
} InstDataStruc;
/* end InstDataStruc (total 0x0014 bytes) */
#pragma pack(pop)
%enddef

