#--------------------------------------
%defconstbitfield
description     Flags for _Allocate_Global_V86_Data_Area (GVDA*)
description
description     Source: Windows 3.1 DDK, D:\386\INCLUDE\VMM.INC, line 865

#                                               default=1   default=(1<<width)-1
#       constant                    bit number  bit width   value   comment
def     GVDAWordAlign               0                             ; Align block on a word boundary
def     GVDADWordAlign	            1                             ; Align block on a doubleword boundary
def     GVDAParaAlign	              2                             ; Align block on a paragraph (16-byte) boundary
def     GVDAPageAlign	              3                             ; Align block on a page (4 kilobyte) boundary
def     GVDAInstance	              8                             ; Create an instance data block 
def     GVDAZeroInit	              9                             ; Fill the block with zeros
def     GVDAReclaim	                10                            ; Unmap any physical pages in the block
def     GVDAInquire	                11                            ; Return the size in bytes of the largest block 
def     GVDAHighSysCritOK	          12                            ; Inform that the virtual device can manage a block residing in high MS-DOS memory
%enddef

